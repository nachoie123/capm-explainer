   "localizations": {
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Paso 3 · Sustitución"
     }
    }
   }
  },
  "You searched “%@” → %@": {
   "localizations": {
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Buscaste “%@” → %@"
