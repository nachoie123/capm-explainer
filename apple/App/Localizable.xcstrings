{
 "sourceLanguage": "en",
 "version": "1.0",
 "strings": {
  "Type a company's name or ticker and I'll show you, step by step, how its expected return is calculated.": {
   "localizations": {
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Escribe el nombre o el ticker de una empresa y te enseño, paso a paso, cómo se calcula su retorno esperado."
     }
    }
   }
  },
  "Rf and g are optional. USD uses the live US 10-year Treasury; EUR/GBP use a default you can override here.": {
   "localizations": {
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Rf y g son opcionales. USD usa el bono USA a 10 años en vivo; EUR/GBP usan un valor por defecto que puedes sobrescribir aquí."
     }
    }
   }
  },
  "Calculate": {
   "localizations": {
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Calcular"
     }
    }
   }
  },
  "Searching…": {
   "localizations": {
    "es": {
     "stringUnit": {
      "state": "translated",
      "value": "Buscando…"
     }
    }
   }
  },
  "Company": {
