<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>com.apple.security.app-sandbox</key><true/>
  <key>com.apple.security.network.client</key><true/>
  <!-- Sparkle con sandbox: hablar con su instalador (-spks) y su estado (-spki). Va escrito con el bundle id
       (no $(PRODUCT_BUNDLE_IDENTIFIER)) porque sellar.sh vuelve a firmar con este fichero tal cual. -->
  <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
  <array>
    <string>com.nachosanbenito.capm-spks</string>
    <string>com.nachosanbenito.capm-spki</string>
  </array>
</dict></plist>
